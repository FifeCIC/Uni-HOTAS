{
  "name": "uni-hotas",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Uni-HOTAS - Universal HOTAS App. Map, test and manage HOTAS, HOSAS, yoke and pedal bindings for Star Citizen and Squadron 42, writing straight back to the game XML profiles.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build --base=/Uni-HOTAS/",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:hotas:mapping": "node scripts/check-hotas-mapping-integrity.mjs",
    "check:hotas:mapping:strict": "node scripts/check-hotas-mapping-integrity.mjs --strict",
    "check:hotas:xml-rebind": "node scripts/hotas-xml-rebind-regression.mjs",
    "build:guard": "npm run build && npm run check:bundle",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "nodemon --watch server --ext js,mjs,cjs --ignore server/data/*.json server/index.js",
    "hotas:agent": "node server/peripherals/hotas/agent/HotasModeCompanionAgent.js",
    "hotas:agent:dry": "node server/peripherals/hotas/agent/HotasModeCompanionAgent.js --dry-run",
    "start": "node server/index.js",
    "serve": "npm run build:local && node server/index.js",
    "build:local": "vite build --base=/",
    "desktop": "electron .",
    "desktop:dev": "npm run build:local && electron .",
    "predist:win": "node scripts/generate-icon.mjs",
    "dist:win": "npm run build:local && electron-builder --win --publish never",
    "pack:win": "npm run build:local && electron-builder --win --dir",
    "server:3111": "set PORT=3111&& nodemon --watch server --ext js,mjs,cjs --ignore server/data/*.json server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "helmet": "8.1.0",
    "nodemailer": "^8.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.25.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "nodemon": "^3.1.11",
    "vite": "^7.3.2",
    "@arwes/animated": "1.0.0-next.25020502",
    "@arwes/frames": "1.0.0-next.25020502",
    "@arwes/react": "1.0.0-next.25020502",
    "@arwes/react-animated": "1.0.0-next.25020502",
    "@arwes/react-bgs": "1.0.0-next.25020502",
    "@arwes/react-frames": "1.0.0-next.25020502",
    "@arwes/react-text": "1.0.0-next.25020502",
    "@arwes/text": "1.0.0-next.25020502",
    "@arwes/theme": "1.0.0-next.25020502",
    "@mantine/core": "^8.3.13",
    "@mantine/dates": "^8.3.13",
    "@mantine/form": "^8.3.14",
    "@mantine/hooks": "^8.3.13",
    "@mantine/notifications": "^8.3.14",
    "@tabler/icons-react": "^3.41.1",
    "@tanstack/react-query": "^5.96.2",
    "arwes": "1.0.0-next.25020502",
    "brace-expansion": "^5.0.5",
    "dayjs": "^1.11.20",
    "fast-xml-parser": "^5.7.1",
    "jsonc-parser": "^3.3.1",
    "motion": "^10.18.0",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^2.3.2",
    "qs": "^6.14.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-moveable": "^0.56.0",
    "react-resizable": "^3.1.3",
    "react-router-dom": "^7.14.0",
    "rollup": "^4.59.0",
    "serialize-javascript": "^7.0.5",
    "web-vitals": "^4.2.4",
    "zod": "^4.3.6",
    "zustand": "^5.0.12",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "main": "desktop/main.cjs",
  "author": {
    "name": "FifeCIC",
    "email": "mail@ryanbayne.uk",
    "url": "https://fifecic.scot"
  }
}
